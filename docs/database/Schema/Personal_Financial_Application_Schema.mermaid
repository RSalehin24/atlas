erDiagram

BANK ||--o{ BRANCH : has
BANK ||--o{ ACCOUNT : issues
BANK ||--o{ SAVINGS_CERTIFICATE : issues
BANK ||--o{ SMS_PARSING_RULE : "formats for"
BRANCH ||--o{ ACCOUNT : "registered at"

ACCOUNT |o--o{ CARD : "may issue"
ACCOUNT ||--o{ TRANSACTION : has
ACCOUNT ||--o{ INVESTMENT : funds
ACCOUNT ||--o{ LENT : funds
ACCOUNT ||--o{ RECURRING_TRANSACTION_TEMPLATE : schedules
ACCOUNT ||--o{ STATEMENT : "monthly statement"
ACCOUNT ||--o{ TAX_REBATE_CONTRIBUTION : "DPS leg"
ACCOUNT ||--o{ ACCOUNT_TERM_DETAIL : "FDR/DPS detail"
ACCOUNT ||--o{ LOAN_DETAIL : "LOAN detail"

LOAN_DETAIL ||--o{ EMI_AMORTIZATION_SCHEDULE : amortizes

CARD ||--o{ TRANSACTION : "used in"
CARD ||--o{ STATEMENT : "credit card statement"

TAX_SPENDING_HEAD ||--o{ CATEGORY : "maps categories to NBR heads"
TAX_SPENDING_HEAD ||--o{ TAX_YEAR_INCOME_SOURCE : "income schedule breakdown"

CATEGORY ||--o{ TRANSACTION : classifies
CATEGURE ||--o{ CATEGORY : "has subcategory"
CATEGORY ||--o{ RECURRING_TRANSACTION_TEMPLATE : classifies

RECURRING_TRANSACTION_TEMPLATE ||--o{ TRANSACTION : generates
TRANSACTION ||--o| TRANSACTION : "transfer pair"
TRANSACTION }o--o{ TAG : "via TransactionTag"

INVESTMENT_COMPANY ||--o{ INVESTMENT : receives

TAX_PROFILE ||--o{ TAX_YEAR : "per-FY computation"

TAX_YEAR ||--o{ TAX_YEAR_INCOME_SOURCE : "income by schedule"
TAX_YEAR ||--o| TAX_YEAR_COMPUTATION_DETAIL : "computation trace"
TAX_YEAR ||--o{ TPS_DEDUCTION : "monthly TPS"
TAX_YEAR ||--o{ WEALTH_ASSET : "wealth snapshot"
TAX_YEAR ||--o{ TAX_REBATE_PLAN : "rebate planning"
TAX_YEAR ||--o{ TAX_REBATE_CONTRIBUTION : "per-instrument per-FY"
TAX_YEAR ||--o{ REBATE_CLAWBACK_EVENT : "cross-year clawback"

TAX_REBATE_PLAN ||--o{ TAX_REBATE_CONTRIBUTION : groups

WEALTH_CATEGORY ||--o{ WEALTH_ASSET : categorizes

TAX_RATE_SET ||--o{ TAX_SPENDING_HEAD : "NBR heads for this FY"
TAX_RATE_SET ||--o{ CATEGORY : "system-seeded categories for this FY"
TAX_RATE_SET ||--o{ TAX_SLAB : defines
TAX_RATE_SET ||--o{ TAX_FREE_THRESHOLD : defines
TAX_RATE_SET ||--o{ SALARY_EXEMPTION_RULE : defines
TAX_RATE_SET ||--o{ REBATE_RULE : defines
TAX_RATE_SET ||--o{ ELIGIBLE_INVESTMENT : lists
TAX_RATE_SET ||--o{ SURCHARGE_RULE : defines
TAX_RATE_SET ||--o{ MINIMUM_TAX_RULE : defines
TAX_RATE_SET ||--o{ FILING_TIMELINE_RULE : defines

STATEMENT ||--o{ STATEMENT_LINE : contains
STATEMENT_LINE ||--o| TRANSACTION : reconciles

SMS_PARSING_RULE ||--o{ PARSED_SMS_LOG : matches
PARSED_SMS_LOG ||--o| TRANSACTION : creates

%% Polymorphic entities (app-layer FK, not DB enforced)
%% NOMINEE }o--|| ACCOUNT : "owner_type=ACCOUNT"
%% NOMINEE }o--|| SAVINGS_CERTIFICATE : "owner_type=SAVINGS_CERTIFICATE"
%% ATTACHMENT }o--|| ACCOUNT : "owner_type=ACCOUNT"
%% ATTACHMENT }o--|| INVESTMENT : "owner_type=INVESTMENT"
%% ATTACHMENT }o--|| LENT : "owner_type=LENT"
%% ATTACHMENT }o--|| TRANSACTION : "owner_type=TRANSACTION"
%% ATTACHMENT }o--|| SAVINGS_CERTIFICATE : "owner_type=SAVINGS_CERTIFICATE"

BANK {
    int id PK
    string name
    string institution_type "BANK, MFS, NBFI"
    string swift_code "nullable"
    string logo_url "nullable"
    bool is_deleted
}

BRANCH {
    int id PK
    int bank FK
    string name
    string routing_number "nullable"
    string address "nullable"
    string district "nullable"
    string contact_number "nullable"
    bool is_deleted
}

ACCOUNT {
    int id PK
    int bank FK
    int branch FK "nullable"
    string identifier_name
    string account_number "encrypt at rest"
    string type "SAVINGS, CURRENT, DPS, FDR, LOAN"
    string account_holder_name
    string mobile_number "nullable"
    string email "nullable"
    string currency "BDT"
    int current_balance "see notes"
    int overdraft_limit "CURRENT only, nullable"
    string status "ACTIVE, CLOSED, MATURED, DEFAULTED"
    date opening_date
    bool is_deleted
}

ACCOUNT_TERM_DETAIL {
    int account_id PK FK
    date start_date
    date maturity_date
    int tenure_months
    float interest_rate
    float vat_rate
    int gross_interest "computed"
    int vat_amount "computed"
    int net_interest "computed"
    int maturity_amount "computed"
    bool auto_renewal
    int principal_amount "FDR only"
    int installment_amount "DPS only"
    int installment_date "DPS only, 1-31"
    int total_principal_on_maturity "DPS, computed"
    bool is_tax_rebate_eligible "DPS, def false"
}

LOAN_DETAIL {
    int account_id PK FK
    string loan_type "PERSONAL, AUTO, HOME, CREDIT_CARD_EMI, INFORMAL, OTHER"
    date disbursed_date
    date start_date
    date end_date
    int principal_amount
    float interest_rate "nullable"
    int processing_fee "nullable"
    int emi_amount
    int installment_date
    int duration_months
    int total_emi_payable "computed"
    int total_paid "computed from transactions"
    string repayment_status "ONGOING, REPAID, DEFAULTED"
    bool is_interest_tax_deductible "def false"
    int tax_deductible_interest_this_year "nullable"
}

EMI_AMORTIZATION_SCHEDULE {
    int id PK
    int loan_detail FK
    int installment_number
    date due_date
    int emi_amount
    int interest_component "computed"
    int principal_component "computed"
    int outstanding_balance
    bool is_paid
    date paid_date "nullable"
    int transaction FK "nullable"
}

NOMINEE {
    int id PK
    string owner_type "ACCOUNT, SAVINGS_CERTIFICATE"
    int owner_id "app-layer FK"
    string name
    string relationship
    float percentage_share
    string contact_number "nullable"
    date date_of_birth "nullable"
    string guardian_name "for minors, nullable"
    bool is_deleted
}

CARD {
    int id PK
    int account FK "nullable"
    string type "DEBIT, CREDIT"
    string network "VISA, MASTERCARD, AMEX, TAKAPAY, DINERS_CLUB"
    string card_number_masked "last 4"
    string card_number_encrypted "nullable"
    string card_holder_name
    string expire_month
    string expire_year
    int balance
    int credit_limit "CREDIT, nullable"
    int billing_cycle_day "CREDIT, nullable"
    date payment_due_date "CREDIT, nullable"
    int minimum_due "CREDIT, nullable"
    int annual_fee "nullable"
    string status "ACTIVE, BLOCKED, EXPIRED, CANCELLED"
    bool is_deleted
}

TRANSACTION {
    int id PK
    int account FK
    int card FK "nullable"
    int category FK "nullable"
    string type "DEBIT, CREDIT"
    int amount "always positive"
    string currency
    int balance_after "nullable"
    datetime transaction_date
    date value_date "nullable"
    string description
    string counterparty_name "nullable"
    string counterparty_account "nullable"
    string method "CASH, NPSB, BEFTN, RTGS, EFTN, MOBILE_BANKING, CARD, INTERNAL_TRANSFER, CHEQUE, STANDING_INSTRUCTION, OTHER"
    string reference_number "nullable"
    string status "PENDING, COMPLETED, FAILED, REVERSED"
    string source "MANUAL, SMS_PARSED, STATEMENT_IMPORT, API"
    int raw_sms FK "nullable"
    int statement_line FK "nullable"
    datetime reconciled_at "nullable"
    int linked_transfer FK "self, nullable"
    int recurring_template FK "nullable"
    int attachment FK "nullable"
    string notes "nullable"
    bool is_deleted
}

TAX_SPENDING_HEAD {
    int id PK
    int rate_set FK
    string code "Sch-1, IT-10BB:2, Section 44"
    string name "NBR head name"
    string head_type "INCOME, DEDUCTION, REBATE_ELIGIBLE, ALLOWANCE, EXEMPTION"
    string description "nullable"
    bool is_deleted
}

CATEGORY {
    int id PK
    int rate_set FK "nullable, user-created"
    int parent_category FK "nullable"
    string name
    int tax_head FK "nullable"
    string type "INCOME, EXPENSE, TRANSFER, INVESTMENT, LOAN, LOAN_REPAYMENT"
    string icon "nullable"
    string color "nullable"
    bool is_system
    bool is_deleted
}

TAG {
    int id PK
    string name
    string color
    bool is_deleted
}

TRANSACTION_TAG {
    int transaction FK
    int tag FK
}

SAVINGS_CERTIFICATE {
    int id PK
    int bank FK
    string certificate_number
    string category_code "5Y_BSP, 3Y_BSP, FAMILY_SAVINGS, PENSIONER, MONTHLY_PROFIT, OTHER"
    string name
    string holder_name
    string joint_holder_name "nullable"
    string joint_holder_relation "nullable"
    string holder_gender "nullable"
    date date_of_birth "nullable"
    string bank_account_for_profit "nullable"
    int face_value
    date issue_date
    date schedule_maturity_date
    int tenure_months "nullable"
    float interest_rate "nullable"
    float vat_rate "nullable"
    int expected_maturity_amount "computed"
    string profit_payment_frequency "MONTHLY, QUARTERLY, HALF_YEARLY, ANNUALLY, AT_MATURITY"
    date encashment_date "nullable"
    bool is_tax_rebate_eligible "def true"
    string status "ACTIVE, ENCASHED, MATURED"
    bool is_deleted
}

INVESTMENT {
    int id PK
    int investment_company FK
    int funding_account FK "nullable"
    datetime investment_datetime
    string method
    string order_reference "nullable"
    int principal_amount
    date expected_return_date "nullable"
    date actual_return_date "nullable"
    int return_amount "nullable"
    int profit "computed, nullable"
    string status "ACTIVE, MATURED, DEFAULTED"
    bool is_deleted
}

INVESTMENT_COMPANY {
    int id PK
    string name
    string address "nullable"
    string contact_info "nullable"
    string website "nullable"
    bool is_deleted
}

LENT {
    int id PK
    string direction "LENT_OUT, BORROWED"
    string counterparty_name
    int account FK
    string method
    int amount
    date lent_date
    date expected_return_date "nullable"
    date actual_return_date "nullable"
    string status "OUTSTANDING, PARTIALLY_RETURNED, RETURNED, WRITTEN_OFF"
    string proof_reference "nullable"
    string notes "nullable"
    bool is_deleted
}

RECURRING_TRANSACTION_TEMPLATE {
    int id PK
    int account FK
    int category FK "nullable"
    int amount
    string type "DEBIT, CREDIT"
    string frequency "WEEKLY, MONTHLY, QUARTERLY, YEARLY"
    int day_of_period
    string description
    date next_due_date
    date end_date "nullable"
    bool auto_create
    bool is_active
    bool is_deleted
}

SMS_PARSING_RULE {
    int id PK
    int bank FK
    string sender_id_pattern
    string regex_pattern
    string field_mapping "JSON"
    string account_type "nullable"
    string sample_sms "nullable"
    bool is_active
    bool is_deleted
}

PARSED_SMS_LOG {
    int id PK
    string raw_sms_text
    string sender
    datetime received_at
    int matched_rule FK "nullable"
    string parse_status "PARSED, UNPARSED, FAILED, IGNORED"
    int created_transaction FK "nullable"
    string notes "nullable"
    bool is_deleted
}

ATTACHMENT {
    int id PK
    string owner_type "ACCOUNT, INVESTMENT, LOAN, LENT, TRANSACTION, SAVINGS_CERTIFICATE"
    int owner_id "app-layer FK"
    string name
    string file_path
    string mime_type "pdf, png, jpg, jpeg"
    datetime uploaded_at
    bool is_deleted
}

STATEMENT {
    int id PK
    int account FK "nullable"
    int card FK "nullable"
    int month "1-12"
    int year
    string file_path
    string file_name
    int file_size "bytes"
    string file_hash "SHA-256"
    datetime uploaded_at
    string status "UPLOADED, PARSING, PARSED, RECONCILING, RECONCILED, HAS_ISSUES"
    string notes "nullable"
    bool is_deleted
}

STATEMENT_LINE {
    int id PK
    int statement FK
    int line_number
    date transaction_date
    date value_date "nullable"
    string description
    int amount
    int balance_after "nullable"
    string counterparty_name "nullable"
    string reference_number "nullable"
    string match_status "UNMATCHED, MATCHED, NEW_TRANSACTION, SUSPICIOUS"
    int transaction FK "nullable"
    float confidence "0.0-1.0, nullable"
    datetime matched_at "nullable"
    string matched_by "AUTO, MANUAL"
    int superseded_by FK "self, nullable"
    bool is_deleted
}

TAX_PROFILE {
    int id PK
    string employment_type "PRIVATE_JOB, GOVT_JOB, BUSINESS, FREELANCER, OTHER"
    string tin_number "nullable"
    string tax_circle "nullable"
    string tax_zone "nullable"
    string employer_name "nullable"
    string employer_address "nullable"
    string employer_tin "nullable"
    string contact_number "nullable"
    string email "nullable"
    string taxpayer_category "GENERAL, WOMAN, SENIOR_CITIZEN, THIRD_GENDER_DISABLED, FREEDOM_FIGHTER, PARENT_OF_DISABLED"
    bool is_deleted
}

TAX_YEAR_INCOME_SOURCE {
    int id PK
    int tax_year FK
    int tax_head FK
    string schedule_code "Sch-1 through Sch-5, FINANCIAL_ASSETS, OTHER_SOURCES, FIRM_AOP, MINOR_SPOUSE, FOREIGN"
    int gross_amount
    int exempted_amount
    int reduced_rate_amount
    int minimum_tax_amount
    int final_tax_amount
    int taxable_amount "computed"
    int tax_computed "computed"
}

TAX_YEAR {
    int id PK
    string financial_year "2026-2027"
    int tax_profile FK
    string status "DRAFT, COMPUTED, FILED"
    string notes "nullable"
    int total_gross_income "computed"
    int total_exempted_income "computed"
    int standard_deduction_applied "computed"
    int total_taxable_income_A "computed"
    int tax_before_rebate "computed"
    int minimum_tax_applied "nullable"
    int vat_on_interest "computed"
    int advance_tax_paid "computed"
    int total_rebate_claimed "computed"
    int max_possible_rebate "computed"
    int investment_required_for_max_rebate "computed"
    int rebate_clawback_amount "computed"
    int surcharge_amount "computed"
    int filing_incentive_amount "computed"
    int filing_penalty_amount "computed"
    int net_tax_payable "computed"
    bool is_deleted
}

TAX_YEAR_COMPUTATION_DETAIL {
    int tax_year PK FK
    int section_78_A
    int section_78_B
    string rebate_computation "JSON"
    string slab_breakdown "JSON"
    int minimum_tax_checked
    bool surcharge_wealth_threshold_crossed
    int filing_quarter
    string income_schedule_summary "JSON"
}

TPS_DEDUCTION {
    int id PK
    int tax_year FK
    int month "1-12, Jul=1"
    int amount
    string employer_name "nullable"
    string notes "nullable"
    bool is_deleted
}

REBATE_CLAWBACK_EVENT {
    int id PK
    int source_tax_year FK
    string investment_type "DPS, SAVINGS_CERTIFICATE"
    int investment_id
    string original_financial_years "JSON array"
    string original_rebate_claimed_per_fy "JSON object"
    int total_rebate_clawed_back
    string reason
    datetime created_at
}

TAX_REBATE_PLAN {
    int id PK
    int tax_year FK
    string financial_year
    int max_eligible_amount
    int target_investment
    string notes "nullable"
    bool is_active
}

TAX_REBATE_CONTRIBUTION {
    int id PK
    int tax_year FK
    int plan FK "nullable"
    int dps_account FK "nullable"
    int savings_certificate FK "nullable"
    int monthly_installment "nullable"
    date start_date
    date end_date
    int total_investment "computed"
    int rebate_claimed "computed"
    string notes "nullable"
}

WEALTH_CATEGORY {
    int id PK
    string name
    bool is_liability
    bool is_system
    int sort_order
    bool is_deleted
}

WEALTH_ASSET {
    int id PK
    int tax_year FK
    int wealth_category FK
    string description "nullable"
    int amount
    string source "COMPUTED, MANUAL"
    string notes "nullable"
    bool is_deleted
}

TAX_RATE_SET {
    int id PK
    string financial_year
    string label
    bool is_active "only one"
    string notes "nullable"
    bool is_deleted
}

TAX_SLAB {
    int id PK
    int rate_set FK
    int slab_order
    int min_income
    int max_income "nullable, rest"
    float rate_percent "e.g. 10.0"
}

TAX_FREE_THRESHOLD {
    int id PK
    int rate_set FK
    string category_code "GENERAL, WOMAN, SENIOR_CITIZEN, THIRD_GENDER_DISABLED, FREEDOM_FIGHTER, PARENT_OF_DISABLED"
    string category_label
    int exempt_amount
}

SALARY_EXEMPTION_RULE {
    int id PK
    int rate_set FK
    int max_exempt_amount "e.g. 500000"
    float percent_of_salary "e.g. 33.33"
    string description "nullable"
}

REBATE_RULE {
    int id PK
    int rate_set FK
    string label
    float rate_percent_of_A "e.g. 3.0"
    float rate_percent_of_B "e.g. 10.0"
    int max_rebate_amount "e.g. 750000"
}

ELIGIBLE_INVESTMENT {
    int id PK
    int rate_set FK
    string instrument_code "DPS, 5Y_BSP, 3Y_BSP, FAMILY_SAVINGS, PENSIONER, MONTHLY_PROFIT, LIFE_INSURANCE, PF, GPS, PENSION, GOVT_SECURITIES, MUTUAL_FUND, LISTED_SHARES, ICB_UNIT, CHARITABLE_DONATION, UNIVERSAL_PENSION"
    string instrument_name
    string filer_category "FIRST_TIME, REPEAT, ALL"
    int max_annual_limit "nullable"
    int min_purchase_amount "nullable"
    bool is_joint_allowed
    int joint_max_annual_limit "nullable"
    string eligibility_rules "JSON, nullable"
    bool is_active
    string description "nullable"
}

SURCHARGE_RULE {
    int id PK
    int rate_set FK
    int threshold_low
    int threshold_high "nullable"
    float surcharge_rate "e.g. 10.0"
    string description "nullable"
}

MINIMUM_TAX_RULE {
    int id PK
    int rate_set FK
    string location_code "MAJOR_CITY, OTHER_CITY, OTHER_AREA, NEW_TAXPAYER"
    string location_label
    int min_tax_amount "e.g. 5000"
}

FILING_TIMELINE_RULE {
    int id PK
    int rate_set FK
    int quarter_number "1-4"
    string quarter_label "Jul-Sep"
    int start_month
    int end_month
    float rebate_percent "nullable"
    int rebate_max_amount "nullable"
    float penalty_percent "nullable"
    int penalty_max_amount "nullable"
}
